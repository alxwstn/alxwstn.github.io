---
import { Image } from "astro:assets";

import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
const { pageTitle, image, imageAlt, pageHeader } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌱</text></svg>"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body class="flex flex-col h-screen">
    <Navigation />
    <div class="wip-bg flex-grow">
      <div class="flex flex-col mx-2 mt-1 md:flex-row md:max-w-4xl md:mx-auto">
        <div class="md:flex-1 self-center mx-2">
          <Image
            layout="constrained"
            src={image}
            alt={imageAlt}
            class="header-image w-auto"
          />
        </div>
        <div class="m-2 md:flex-2">
          <h1 class="card border border-gray-400 text-center">{pageHeader}</h1>
          <slot name="header-content" />
        </div>
        <slot />
      </div>
      <div>
        <slot name="main-content" />
      </div>
    </div>
    <div
      class="flex flex-col p-2 sm:flex-row bg-white justify-center items-center"
    >
      <div>© 2026 Alexandra Walton Weston</div>
      <div class="mx-2 hidden sm:block">&#8226;</div>
      <div>
        Built by me using <a
          href="text-deco https://astro.build/"
          class="underline">Astro 7</a
        > and <a href="https://tailwindcss.com/" class="underline"
          >Tailwind CSS</a
        >
      </div>
    </div>
  </body>
</html>
