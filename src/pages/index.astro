---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import image from "../content/images/profile.jpg";

const pageTitle = "Alexandra Walton Weston Portfolio";
const pageHeader = "Hi, I'm Alex 👋";
const imageAlt = "profile image of Alexandra Walton Weston";
const categories = await getCollection("category");
---

<BaseLayout
  pageTitle={pageTitle}
  pageHeader={pageHeader}
  image={image}
  imageAlt={imageAlt}
>
  <div
    slot="header-content"
    class="mt-2 card border border-gray-400 text-center"
  >
    I'm an early-career natural resources professional with a background in
    software and data analysis. I have experience working on trails, field
    surveys, and GIS projects. I'm always looking for opportunities to grow and
    develop new skills. Click the categories below for a look at my work
    experience and projects.
  </div>

  <div
    slot="main-content"
    class="mx-2 mt-1 md:max-w-4xl md:mx-auto"
    mx-2
    mt-1
    md:max-w-4xl
    md:mx-auto
  >
    {
      categories
        .sort((a, b) => a.data.priority - b.data.priority)
        .map((category) => (
          <div class="bg-white/40 border border-gray-300 shadow-xl rounded-lg m-2 p-2 flex flex-col items-center">
            <a class="w-full" href={`projects/${category.id}`}>
              <h2 class=" text-center">{category.data.name}</h2>
            </a>
            <a href={`projects/${category.id}`}>
              <Image
                src={category.data.image}
                alt={category.data.imageAlt}
                class="header-image w-auto md:max-w-64"
              />
            </a>
          </div>
        ))
    }
  </div>
</BaseLayout>
