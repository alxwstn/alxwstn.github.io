---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import image from "../content/images/profile.jpg";

const pageTitle = "Alexandra Walton Weston Portfolio";
const pageHeader = "Hi, I'm Alex 👋";
const imageAlt = "profile image of Alexandra Walton Weston";
const categories = await getCollection("category");
---

<BaseLayout
  pageTitle={pageTitle}
  pageHeader={pageHeader}
  image={image}
  imageAlt={imageAlt}
>
  <div
    slot="header-content"
    class="mt-2 card border border-gray-400 text-center"
  >
    <p>
      I'm an early-career natural resources professional with a background in
      software engineering and data analysis. I've maintained trails in forest
      and chaparral ecosystems, surveyed invasive and native plants, conducted
      homeless censuses and surveys, mapped riparian trash and pollution data,
      and analyzed GIS information. Whether it's identifying invasive species or
      debugging a data pipeline, I like getting into the weeds to figure out how
      things work.
    </p>
    <p class="my-2">
      Take a look at my experience below and&nbsp;
      <a href="mailto:alexwweston@gmail.com" class="underline">
        send me an email here</a
      >.
    </p>

    <div class="card bg-amber-100 text-center">
      Available for part-time and full-time employment November 2026
    </div>
  </div>

  <div
    slot="main-content"
    class="mx-2 mt-1 md:max-w-4xl md:mx-auto md:flex md:flex-row md:flex-wrap md:justify-center"
  >
    {
      categories
        .sort((a, b) => a.data.priority - b.data.priority)
        .map((category) => (
          <div class=" m-2 p-2 flex flex-col items-center">
            <a class="mb-2" href={`projects/${category.id}`}>
              <h2 class="p-2 px-4 bg-white/80 border border-gray-300 shadow-xl rounded-lg text-center">
                {category.data.name}
              </h2>
            </a>
            <a href={`projects/${category.id}`}>
              <Image
                src={category.data.image}
                alt={category.data.imageAlt}
                layout="constrained"
                class="header-image w-64"
              />
            </a>
          </div>
        ))
    }
  </div>
</BaseLayout>
