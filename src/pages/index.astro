---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import image from "../content/images/profile.jpg";

const pageTitle = "Alexandra Walton Weston Portfolio";
const pageHeader = "Hi, I'm Alex 👋";
const imageAlt = "profile image of Alexandra Walton Weston";
const categories = await getCollection("category");
---

<BaseLayout
  pageTitle={pageTitle}
  pageHeader={pageHeader}
  image={image}
  imageAlt={imageAlt}
>
  <div
    slot="header-content"
    class="mt-2 card border border-gray-400 text-center"
  >
    <p>
      I'm an early-career natural resources professional with a background in
      software engineering and data analysis. I've maintained trails in forest
      and chaparral landscapes, surveyed invasive and native plants, conducted
      homeless censuses and surveys, mapped riparian trash and pollution data,
      and analyzed GIS data. Whether it's identifying invasive species or
      debugging a data pipeline, I like figuring out how systems work and
      getting into the weeds.
    </p>
    <p class="my-2">
      Click the categories below for a look at my work experience and projects.
    </p>

    <div class="card bg-amber-100 text-center">
      Available for part-time and full-time employment November 2026
    </div>
  </div>

  <div slot="main-content" class="mx-2 mt-1 md:max-w-4xl md:mx-auto">
    {
      categories
        .sort((a, b) => a.data.priority - b.data.priority)
        .map((category) => (
          <div class="bg-white/70 border border-gray-300 shadow-xl rounded-lg m-2 p-2 flex flex-col items-center">
            <a class="w-full" href={`projects/${category.id}`}>
              <h2 class="mb-2 text-center">{category.data.name}</h2>
            </a>
            <a href={`projects/${category.id}`}>
              <Image
                src={category.data.image}
                alt={category.data.imageAlt}
                layout="constrained"
                class="header-image w-64"
              />
            </a>
          </div>
        ))
    }
  </div>
</BaseLayout>
