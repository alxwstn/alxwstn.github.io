---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Project from "../../components/Project.astro";
import { length } from "astro:schema";

export async function getStaticPaths() {
  const categories = await getCollection("category");
  return categories.map((category) => ({
    params: { slug: category.id },
    props: { category },
  }));
}

const { category } = Astro.props;
const projects = await getCollection("project", ({ data }) => {
  return data.categories.includes(category.id);
});

const certs = await getCollection("cert", ({ id }) => {
  return category.data.certs?.includes(id);
});
---

<BaseLayout
  pageTitle={category.data.name}
  pageHeader={category.data.name}
  image={category.data.image}
  imageAlt={category.data.imageAlt}
>
  {
    certs.length > 0 && (
      <div
        slot="header-content"
        class="mt-2 card border border-gray-400 text-center"
      >
        <h2 class="pb-4">Certifications & Education</h2>

        <ul>
          {certs.sort((a, b) => a.data.priority - b.data.priority).map((cert) => (
            <li>
              <div class="font-semibold">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="size-6 inline mr-0.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z"
                  />
                </svg>
                {cert.data.title}
              </div>
              <div>
                <span>{cert.data.organization}</span>
                <span class="hidden sm:inline mx-0.5">&#8226;</span>
                <span class="hidden sm:inline">{cert.data.location}</span>
                {cert.data.date && (
                  <span class="mx-0.5">&#8226;</span>
                  <span>
                    {new Date(cert.data.date).toLocaleDateString("en-US", {
                      year: "2-digit",
                      month: "numeric",
                      day: "numeric",
                    })}
                  </span>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    )
  }
  <div slot="main-content" class="mx-2 mt-1 md:max-w-4xl md:mx-auto">
    {
      projects
        .sort((a, b) => a.data.priority - b.data.priority)
        .map((project) => <Project project={project} />)
    }
  </div>
</BaseLayout>
