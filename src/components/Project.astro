---
import { Image } from "astro:assets";

const { data } = Astro.props.project;
---

<div
  class="bg-white/70 border border-gray-300 shadow-xl rounded-lg m-2 p-2 flex flex-col items-center"
>
  <h2 class="text-center">{data.title}</h2>
  <div class="flex flex-col md:flex-row md:gap-2 w-full p-4">
    <div class="flex-1">
      <ul>
        <li>
          <span class="font-semibold">Organization: </span>{data.organization}
        </li>
        <li>
          <span class="font-semibold">Location: </span>{data.location}
        </li>
        <li>
          <span class="font-semibold">Overview: </span>{data.description}
        </li>
      </ul>
    </div>
    <div class="flex-1">
      <span class="font-semibold">Details: </span>
      <ul class="list-disc">
        {data.duties.map((duty) => <li class="ml-5">{duty}</li>)}
      </ul>
    </div>
  </div>
  <ul class="flex overflow-x-auto w-full">
    {
      data.images.length > 0 &&
        data.images.map(({ src, alt }) => (
          <li class="h-72">
            <Image
              class="max-h-full max-w-fit min-w-0 align-bottom shrink-0"
              src={src}
              alt={alt}
            />
          </li>
        ))
    }
  </ul>
</div>
