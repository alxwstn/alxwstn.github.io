---
import { Image } from "astro:assets";
import inatImg from "../content/icons/inat.png";
import githubImg from "../content/icons/github.png";
---

<div
  class="grid grid-cols-[1fr_auto_1fr] grid-rows-1 p-2 border border-gray-400 bg-white navigation"
>
  <a href="/" class="justify-self-start"
    ><svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      class="size-6 stroke-gray-700 inline"
    >
      <title>navigate to home page</title>
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
      ></path>
    </svg>
  </a>
  <div class="justify-self-center">
    <span class="md:hidden">A.</span><span class="hidden md:inline"
      >Alexandra</span
    > Walton Weston
  </div>
  <!-- adds a smidge of bot protection per https://spencermortensen.com/articles/email-obfuscation/#link-entity -->
  <!-- prettier-ignore -->
  <div class="flex justify-self-end">
  <a href="&#109;&#97;&#105;&#108;&#116;&#111;&#58;&#97;&#108;&#101;&#120;&#119;&#119;&#101;&#115;&#116;&#111;&#110;&#64;&#103;&#109;&#97;&#105;&#108;&#46;&#99;&#111;&#109;" class="email">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      class="size-6 stroke-gray-700 inline"
    >
      <title>Send email to Alexandra Walton Weston</title>
      <path
        d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
      ></path>
    </svg>
  </a>
  <a href="https://www.inaturalist.org/people/alxwstn" class="mx-1">
    <Image src={inatImg} alt="Navigate to iNaturalist.org user profile" class="size-6" alt="iNaturalist logo" />
  </a>
  <a href="https://github.com/alxwstn" class="mx-1">
    <Image src={githubImg} alt="Navigate to Github.com user profile" class="size-6" alt="iNaturalist logo" />
  </a>
  </div>
</div>
